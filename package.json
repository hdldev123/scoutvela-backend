{
  "name": "vela-back",
  "version": "0.1.0",
  "private": true,
  "description": "API do Scout Vela: Talent ID da vela olímpica",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:local": "tsx dev/cli-local.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/cli-migrar.ts",
    "db:migrate:prod": "node dist/src/db/cli-migrar.js",
    "db:seed": "tsx seed/cli-seed.ts",
    "seed:auth": "tsx seed/cli-auth.ts",
    "openapi": "tsx src/cli-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.16",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@supabase/supabase-js": "^2.119.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "openapi-types": "^12.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
