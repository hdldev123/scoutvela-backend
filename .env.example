# Copie para .env (fora do git) e preencha. No Render, cadastre no painel do serviço.

# desenvolvimento | homologacao | producao  (seed recusa producao; /docs some em producao)
APP_ENV=desenvolvimento
PORT=3333

# Postgres do Supabase (Project Settings > Database > Connection string, modo session).
# Credencial de servidor: só no .env local e no Render, nunca no front.
# Use o pooler em modo SESSION (porta 5432): a conexão direta é só IPv6 e o Render sai por IPv4.
# Copie de Connect > Connection string > Session pooler; o host varia por projeto.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Certificado CA do Supabase (PEM, Project Settings > Database > SSL). Vazio = sem TLS (só banco local).
DATABASE_CA_CERT=

# Supabase Auth: a API valida o JWT de sessão que o front envia em Authorization.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Só se o projeto usar a chave JWT legada (HS256). Projetos novos validam pelo JWKS e deixam vazio.
SUPABASE_JWT_SECRET=

# Só para `npm run seed:auth` (cria as contas de teste no Supabase Auth). Nunca no front.
SUPABASE_SERVICE_ROLE_KEY=

# Só para `npm run db:verificar`: chave pública (anon ou publishable) usada para conferir que ela não lê nada.
SUPABASE_ANON_KEY=

# Domínios do front liberados no CORS, separados por vírgula.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Endereço do front, usado nos links dos e-mails (convite, termo, lembretes, redefinição de senha).
FRONT_URL=http://localhost:8080

# Segundo fator (TOTP do Supabase Auth) obrigatório para gestor e IBVAR. true em homologação e produção.
EXIGIR_MFA=false

# E-mail: log (só registra, desenvolvimento) ou smtp (envia). Provedor SMTP a definir pela instituição.
EMAIL_PROVEDOR=log
EMAIL_REMETENTE=Scout Vela <nao-responda@scoutvela.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=

# Evidências anexadas: local (disco, só desenvolvimento) ou supabase (bucket privado; exige SUPABASE_SERVICE_ROLE_KEY).
STORAGE_PROVEDOR=local
STORAGE_BUCKET=evidencias
STORAGE_DIR_LOCAL=.dados-locais/evidencias
