# Copie para .env (fora do git) e preencha. No Render, cadastre no painel do serviço.

# desenvolvimento | homologacao | producao  (seed recusa producao; /docs some em producao)
APP_ENV=desenvolvimento
PORT=3333

# Postgres do Supabase (Project Settings > Database > Connection string, modo session).
# Credencial de servidor: só no .env local e no Render, nunca no front.
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
# Certificado CA do Supabase (PEM, Project Settings > Database > SSL). Vazio = sem TLS (só banco local).
DATABASE_CA_CERT=

# Supabase Auth: a API valida o JWT de sessão que o front envia em Authorization.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Só se o projeto usar a chave JWT legada (HS256). Projetos novos validam pelo JWKS e deixam vazio.
SUPABASE_JWT_SECRET=

# Só para `npm run seed:auth` (cria as contas de teste no Supabase Auth). Nunca no front.
SUPABASE_SERVICE_ROLE_KEY=

# Domínios do front liberados no CORS, separados por vírgula.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
